DATABASE_URL=postgresql+asyncpg://fund_transfer:fund_transfer_pass@localhost:5432/fund_transfer
JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
JWT_AUDIENCE=fund-transfer-service
EXCHANGE_RATES_CONFIG=config/exchange_rates.yaml
LOG_LEVEL=INFO
SERVICE_NAME=fund-transfer-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# FX Rate Provider
FX_PROVIDER_URL=http://treasury-feed.internal/rates
FX_RATE_MAX_AGE_MINUTES=60
FX_RATE_DEVIATION_THRESHOLD_PCT=1
FX_REFRESH_INTERVAL_SECONDS=3600
FX_PROVIDER_TIMEOUT_SECONDS=5
USE_STATIC_RATES=false

# Transfer Limits (USD equivalent)
TRANSFER_LIMIT_PER_TX_USD=50000
TRANSFER_LIMIT_PER_DAY_USD=100000

# AML/KYC
AML_SCREENING_THRESHOLD_USD=10000

# Fee Configuration
SENDING_FEE_PCT=0.005
RECEIVING_FEE_PCT=0.003
